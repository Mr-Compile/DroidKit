<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Same visibility scope as App Inspector: launcher-visible packages only.
      QUERY_ALL_PACKAGES is intentionally not used (frozen V1 decision) —
      apps without a launcher entry stay invisible and the screens say so.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
